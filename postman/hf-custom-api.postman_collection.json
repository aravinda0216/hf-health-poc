  "item": [
    {
      "name": "0 Auth",
      "item": [
        {
          "name": "Create access token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/oauth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "oauth",
                "token"
              ],
              "query": []
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"bearer token\", function () { pm.expect(typeof j.access_token === 'string').to.be.ok; });",
                  "pm.collectionVariables.set('access_token', j.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
